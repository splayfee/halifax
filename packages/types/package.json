{
  "name": "@edium/halifax-types",
  "version": "0.1.0",
  "description": "Shared TypeScript types and enums for @edium/halifax and @edium/halifax-client.",
  "author": "David LaTour <david@edium.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc --build",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "keywords": [
    "halifax",
    "types",
    "query-builder",
    "typescript"
  ],
  "packageManager": "pnpm@11.6.0"
}
