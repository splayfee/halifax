{
  "name": "@edium/halifax-client",
  "version": "3.0.1",
  "description": "Browser AST client for the halifax autocrud API.",
  "author": "David LaTour <david@edium.com>",
  "homepage": "https://github.com/splayfee/halifax/tree/main/packages/client#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/splayfee/halifax.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/splayfee/halifax/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README*.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "rm -rf dist && tsc --build && tsc-alias",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "test:unit": "vitest run tests/unit",
    "test:unit:coverage": "vitest run --coverage tests/unit",
    "type-check": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@edium/halifax-types": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tsc-alias": "^1.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "keywords": [
    "ast",
    "browser",
    "client",
    "crud",
    "halifax",
    "query-builder",
    "rest",
    "typescript"
  ],
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
