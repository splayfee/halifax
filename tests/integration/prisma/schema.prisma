generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Author {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
  posts Post[]

  @@map("authors")
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  Int?
  author    Author?  @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
}

// Tenant-scoped model used by the multi-tenancy integration tests. `companyId` is the
// tenant key; rows belonging to different companies must never be visible across tenants.
model Widget {
  // `companyId` is the tenant key. It is mapped to a lowercase column so the raw-SQL
  // scoping paths (query-builder / updateMany / deleteMany) work: Halifax's QueryBuilder
  // emits unquoted identifiers, which PostgreSQL folds to lowercase. A default Prisma
  // column would be created case-sensitively ("companyId") and the unquoted SQL would miss it.
  companyId Int      @map("companyid")
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("widgets")
}
