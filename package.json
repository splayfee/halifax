{
  "name": "@edium/halifax",
  "version": "1.0.0",
  "description": "Adapter-driven dynamic REST CRUD and SQL query-builder framework for TypeScript APIs.",
  "author": "David LaTour <david@edium.com>",
  "homepage": "https://github.com/splayfee/halifax#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/splayfee/halifax.git"
  },
  "bugs": {
    "url": "https://github.com/splayfee/halifax/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "README_ADAPTERS.md",
    "README_AUTH.md",
    "README_AUTOCRUD.md",
    "README_QUERYBUILDER.md",
    "README_REPOSITORIES.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc --build && tsc-alias",
    "dev": "tsx watch ./src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "test:unit": "vitest run tests/unit",
    "test:unit:coverage": "vitest run --coverage tests/unit",
    "test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
    "test:integration:generate": "prisma generate --schema=tests/integration/prisma/schema.prisma",
    "type-check": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@prisma/client": ">=7.0.0",
    "express": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.2.1",
    "globals": "^17.6.0",
    "pg": "^8.21.0",
    "prettier": "^3.8.4",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "rest",
    "crud",
    "query-builder",
    "typescript",
    "express",
    "prisma",
    "passport",
    "jwt",
    "api"
  ],
  "packageManager": "pnpm@11.5.3",
  "dependencies": {
    "uuid": "^14.0.0"
  }
}
