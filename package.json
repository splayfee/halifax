{
  "name": "@edium/halifax",
  "version": "2.4.0",
  "description": "Auto-generate type-safe REST CRUD APIs from your data models. Adapter-driven: Express/Fastify/HyperExpress, Prisma (PostgreSQL, MySQL, MariaDB, SQL Server, CockroachDB, SQLite), JWT/API-key auth, multi-tenancy, a dynamic query builder, and pluggable Redis caching.",
  "author": "David LaTour <david@edium.com>",
  "homepage": "https://github.com/splayfee/halifax#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/splayfee/halifax.git"
  },
  "bugs": {
    "url": "https://github.com/splayfee/halifax/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/adapters/http/ExpressAdapter.d.ts",
      "import": "./dist/adapters/http/ExpressAdapter.js",
      "default": "./dist/adapters/http/ExpressAdapter.js"
    },
    "./fastify": {
      "types": "./dist/adapters/http/FastifyAdapter.d.ts",
      "import": "./dist/adapters/http/FastifyAdapter.js",
      "default": "./dist/adapters/http/FastifyAdapter.js"
    },
    "./hyper-express": {
      "types": "./dist/adapters/http/HyperExpressAdapter.d.ts",
      "import": "./dist/adapters/http/HyperExpressAdapter.js",
      "default": "./dist/adapters/http/HyperExpressAdapter.js"
    },
    "./ultimate-express": {
      "types": "./dist/adapters/http/UltimateExpressAdapter.d.ts",
      "import": "./dist/adapters/http/UltimateExpressAdapter.js",
      "default": "./dist/adapters/http/UltimateExpressAdapter.js"
    },
    "./drizzle": {
      "types": "./dist/adapters/orm/drizzle/index.d.ts",
      "import": "./dist/adapters/orm/drizzle/index.js",
      "default": "./dist/adapters/orm/drizzle/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "README_AUTH.md",
    "README_AUTOCRUD.md",
    "README_CACHE.md",
    "README_HTTP_ADAPTERS.md",
    "README_GRAPHQL.md",
    "README_MULTITENANCY.md",
    "README_QUERYBUILDER.md",
    "README_REPO_ADAPTERS.md",
    "README_HOOKS.md",
    "README_OPENAPI.md",
    "README_TYPES.md",
    "README_INTERFACES.md",
    "README_CLASSES.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "rm -rf dist && tsc --build && tsc-alias",
    "dev": "tsx watch ./examples/http-express.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "test:unit": "vitest run tests/unit",
    "test:unit:coverage": "vitest run --coverage tests/unit",
    "test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
    "test:integration:all": "bash scripts/integration-matrix.sh",
    "test:integration:generate": "prisma generate --schema=tests/integration/prisma/schema.prisma",
    "type-check": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "type-check:examples": "prisma generate --schema=tests/integration/prisma/schema.prisma && tsc --noEmit -p examples/tsconfig.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@prisma/client": ">=6.0.0",
    "drizzle-orm": ">=0.30.0",
    "express": "^4.17.0 || ^5.0.0",
    "fastify": ">=4.0.0",
    "hyper-express": ">=6.0.0",
    "ultimate-express": ">=2.0.0",
    "graphql": ">=16.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hyper-express": {
      "optional": true
    },
    "ultimate-express": {
      "optional": true
    },
    "graphql": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/adapter-mssql": "7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "better-sqlite3": "^12.10.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.2.1",
    "fastify": "^5.8.5",
    "globals": "^17.6.0",
    "hyper-express": "^6.17.3",
    "pg": "^8.21.0",
    "prettier": "^3.8.4",
    "prisma": "^7.8.0",
    "redis": "^6.0.0",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "ultimate-express": "^2.1.1",
    "graphql": "^17.0.0",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "api",
    "api-framework",
    "autocrud",
    "cache",
    "caching",
    "cockroachdb",
    "crud",
    "crud-api",
    "express",
    "fastify",
    "hyper-express",
    "jwt",
    "multi-tenancy",
    "multi-tenant",
    "mysql",
    "orm",
    "passport",
    "postgresql",
    "prisma",
    "query-builder",
    "redis",
    "rest",
    "rest-api",
    "sqlite",
    "sqlserver",
    "typescript",
    "ultimate-express"
  ],
  "packageManager": "pnpm@11.6.0",
  "dependencies": {
    "@edium/halifax-types": "workspace:*",
    "uuid": "^14.0.0"
  }
}
